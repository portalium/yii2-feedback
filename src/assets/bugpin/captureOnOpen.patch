+import { FunctionComponent } from 'preact';
+import { useEffectiveTheme } from '../hooks/use-effective-theme.js';
+import { useLocale } from '../hooks/use-locale.js';
+import { t } from '../i18n/index.js';
+
+interface FeedbackTabProps {
+  theme: 'auto' | 'light' | 'dark';
+  lightColor: string;
+  lightTextColor: string;
+  darkColor: string;
+  darkTextColor: string;
+  expanded: boolean;
+  onClick: () => void;
+}
+
+// Transforms are plain CSS: Tailwind's translate/rotate utilities rely on @property, which does not work in the
+// widget's shadow root.
+
+/**
+ * Launcher of the 'tab' style: a vertical tab stuck to the middle of the right edge, read from bottom to top.
+ */
+export const FeedbackTab: FunctionComponent<FeedbackTabProps> = ({
+  theme,
+  lightColor,
+  lightTextColor,
+  darkColor,
+  darkTextColor,
+  expanded,
+  onClick,
+}) => {
+  useLocale();
+  const dark = useEffectiveTheme(theme) === 'dark';
+
+  return (
+    <div class="fixed right-0 top-1/2 [transform:translateY(-50%)] z-[2147483645]">
+      <button
+        type="button"
+        class="block border-none cursor-pointer px-2.5 py-4 rounded-r-lg text-sm font-semibold tracking-wide shadow-lg transition-[padding] duration-150 hover:pb-5 [writing-mode:vertical-rl] [transform:rotate(180deg)]"
+        style={{
+          backgroundColor: dark ? darkColor : lightColor,
+          color: dark ? darkTextColor : lightTextColor,
+        }}
+        aria-expanded={expanded}
+        aria-label={t('aria.launcher')}
+        onClick={onClick}
+      >
+        {t('tab.label')}
+      </button>
+    </div>
+  );
+};
