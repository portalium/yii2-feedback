+import { FunctionComponent, JSX } from 'preact';
+import { Camera, MessageSquareText } from 'lucide-preact';
+import { useLocale } from '../hooks/use-locale.js';
+import { t } from '../i18n/index.js';
+import { FeedbackPanel } from './FeedbackPanel.js';
+
+interface FeedbackMenuProps {
+  canAnnotate: boolean;
+  onAnnotate: () => void;
+  onGeneral: () => void;
+  onClose: () => void;
+}
+
+const Choice = ({ icon, label, onClick }: { icon: JSX.Element; label: string; onClick: () => void }) => (
+  <button
+    type="button"
+    class="flex w-full items-center gap-4 px-4 py-4 rounded-xl border border-solid border-border bg-transparent text-left text-base font-semibold text-[var(--button-color)] cursor-pointer transition-colors hover:bg-foreground/5 [&_svg]:w-7 [&_svg]:h-7 [&_svg]:shrink-0"
+    onClick={onClick}
+  >
+    {icon}
+    <span>{label}</span>
+  </button>
+);
+
+/**
+ * First step of the 'tab' style: mark a spot on the page (screenshot + annotation) or write general feedback.
+ */
+export const FeedbackMenu: FunctionComponent<FeedbackMenuProps> = ({
+  canAnnotate,
+  onAnnotate,
+  onGeneral,
+  onClose,
+}) => {
+  useLocale();
+
+  return (
+    <FeedbackPanel title={t('menu.title')} onClose={onClose}>
+      <p class="mt-0 mb-5 text-base text-muted-foreground">{t('menu.intro')}</p>
+      <div class="flex flex-col gap-3">
+        {canAnnotate && <Choice icon={<Camera />} label={t('menu.annotate')} onClick={onAnnotate} />}
+        <Choice icon={<MessageSquareText />} label={t('menu.general')} onClick={onGeneral} />
+      </div>
+    </FeedbackPanel>
+  );
+};
