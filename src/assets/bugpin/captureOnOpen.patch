@@ -0,0 +1,128 @@
+import { FunctionComponent } from 'preact';
+import { useState } from 'preact/hooks';
+import { Camera, CircleCheck } from 'lucide-preact';
+import { useLocale } from '../hooks/use-locale.js';
+import { t } from '../i18n/index.js';
+import { Button, Input, Textarea } from './ui';
+import { FeedbackPanel } from './FeedbackPanel.js';
+import type { FormData } from './WidgetDialog.js';
+
+interface FeedbackFormProps {
+  formData: FormData;
+  onFormDataChange: (data: FormData) => void;
+  hasScreenshot: boolean;
+  canAnnotate: boolean;
+  isSubmitting: boolean;
+  isCapturing: boolean;
+  onEditScreenshot: () => void;
+  onAddScreenshot: () => void;
+  onRemoveScreenshot: () => void;
+  onSubmit: () => void;
+  onClose: () => void;
+}
+
+const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+/**
+ * Last step of the 'tab' style: one comment field, the screenshot (edit or add), an optional email.
+ */
+export const FeedbackForm: FunctionComponent<FeedbackFormProps> = ({
+  formData,
+  onFormDataChange,
+  hasScreenshot,
+  canAnnotate,
+  isSubmitting,
+  isCapturing,
+  onEditScreenshot,
+  onAddScreenshot,
+  onRemoveScreenshot,
+  onSubmit,
+  onClose,
+}) => {
+  useLocale();
+  const [errors, setErrors] = useState<{ comment?: string; email?: string }>({});
+
+  const submit = (event: Event) => {
+    event.preventDefault();
+    const next: typeof errors = {};
+    if (formData.description.trim().length < 3) next.comment = t('form.comment.required');
+    if (formData.reporterEmail.trim() !== '' && !EMAIL.test(formData.reporterEmail.trim())) {
+      next.email = t('validation.email.invalid');
+    }
+    setErrors(next);
+    if (!next.comment && !next.email) onSubmit();
+  };
+
+  return (
+    <FeedbackPanel title={t('menu.title')} onClose={onClose} tall>
+      <form class="flex flex-col gap-4" onSubmit={submit} noValidate>
+        <div>
+          <Textarea
+            class="min-h-32 text-base"
+            placeholder={t('form.comment.placeholder')}
+            value={formData.description}
+            error={!!errors.comment}
+            autoFocus
+            onInput={(event) =>
+              onFormDataChange({ ...formData, description: (event.target as HTMLTextAreaElement).value })
+            }
+          />
+          {errors.comment && <p class="mt-1 mb-0 text-sm text-destructive">{errors.comment}</p>}
+        </div>
+
+        {hasScreenshot ? (
+          <div class="flex items-center gap-3 text-base font-semibold">
+            <button
+              type="button"
+              class="flex items-center gap-2 p-0 border-none bg-transparent text-[var(--button-color)] cursor-pointer [&_svg]:w-6 [&_svg]:h-6"
+              onClick={onEditScreenshot}
+            >
+              <span class="relative">
+                <Camera />
+                <CircleCheck class="absolute -right-1.5 -bottom-1 !w-3.5 !h-3.5 text-green-600 bg-background rounded-full" />
+              </span>
+              {t('form.screenshot.edit')}
+            </button>
+            <button
+              type="button"
+              class="ml-auto p-0 border-none bg-transparent text-sm font-normal text-muted-foreground cursor-pointer hover:underline"
+              onClick={onRemoveScreenshot}
+            >
+              {t('form.screenshot.remove')}
+            </button>
+          </div>
+        ) : (
+          canAnnotate && (
+            <button
+              type="button"
+              class="flex items-center gap-2 p-0 border-none bg-transparent text-base font-semibold text-[var(--button-color)] cursor-pointer disabled:opacity-50 [&_svg]:w-6 [&_svg]:h-6"
+              disabled={isCapturing}
+              onClick={onAddScreenshot}
+            >
+              <Camera />
+              {t('form.screenshot.add')}
+            </button>
+          )
+        )}
+
+        <div>
+          <Input
+            type="email"
+            class="text-base"
+            placeholder={t('form.email.placeholder')}
+            value={formData.reporterEmail}
+            error={!!errors.email}
+            onInput={(event) =>
+              onFormDataChange({ ...formData, reporterEmail: (event.target as HTMLInputElement).value })
+            }
+          />
+          {errors.email && <p class="mt-1 mb-0 text-sm text-destructive">{errors.email}</p>}
+        </div>
+
+        <Button type="submit" class="w-full h-12 text-base font-semibold rounded-lg" disabled={isSubmitting}>
+          {isSubmitting ? t('form.sending') : t('form.submit')}
+        </Button>
+      </form>
+    </FeedbackPanel>
+  );
+};
