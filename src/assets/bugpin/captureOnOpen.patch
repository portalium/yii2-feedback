diff --color -ruN a/widget/launcher-state.ts b/widget/launcher-state.ts
--- a/widget/launcher-state.ts	1970-01-01 02:00:00
+++ b/widget/launcher-state.ts	2026-10-31 21:31:34
@@ -0,0 +1,11 @@
+// Whether the page hides the launcher button (BugPin.hideLauncher): set before or after the widget starts.
+let hidden = false;
+
+export function isLauncherHidden(): boolean {
+  return hidden;
+}
+
+export function setLauncherHidden(value: boolean): void {
+  hidden = value;
+  document.dispatchEvent(new CustomEvent('bugpin:launcher', { detail: value }));
+}
