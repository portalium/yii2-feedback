+import { ComponentChildren, FunctionComponent } from 'preact';
+import { useEffect } from 'preact/hooks';
+import { X } from 'lucide-preact';
+import { t } from '../i18n/index.js';
+
+interface FeedbackPanelProps {
+  title: string;
+  onClose: () => void;
+  /** Fills the phone screen (the form) instead of sitting at the bottom (the choice). */
+  tall?: boolean;
+  children: ComponentChildren;
+}
+
+/**
+ * Shell of the 'tab' style panels: a bottom sheet on phones, a card next to the tab on wider screens.
+ */
+export const FeedbackPanel: FunctionComponent<FeedbackPanelProps> = ({
+  title,
+  onClose,
+  tall,
+  children,
+}) => {
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') onClose();
+    };
+    document.addEventListener('keydown', onKey);
+    return () => document.removeEventListener('keydown', onKey);
+  }, [onClose]);
+
+  return (
+    <div class="fixed inset-0 z-[2147483646]">
+      <div class="absolute inset-0 bg-black/40 sm:bg-transparent" onClick={onClose} />
+      <div
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="bugpin-panel-title"
+        class={
+          'absolute inset-x-0 bottom-0 flex flex-col bg-background text-foreground shadow-2xl ' +
+          'rounded-t-2xl animate-[slideUp_0.2s_ease-out] overflow-y-auto ' +
+          (tall ? 'top-0 rounded-t-none ' : 'max-h-[90vh] ') +
+          'sm:inset-auto sm:right-14 sm:top-1/2 sm:[transform:translateY(-50%)] sm:w-[360px] sm:max-h-[85vh] sm:rounded-xl ' +
+          'sm:border sm:border-solid sm:border-border'
+        }
+      >
+        <div class="flex items-center justify-between px-5 pt-5 pb-2">
+          <h2 id="bugpin-panel-title" class="m-0 text-xl font-bold">
+            {title}
+          </h2>
+          <button
+            type="button"
+            class="flex items-center justify-center w-8 h-8 border-none rounded-full bg-transparent text-foreground cursor-pointer hover:bg-foreground/10 [&_svg]:w-5 [&_svg]:h-5"
+            aria-label={t('aria.close')}
+            onClick={onClose}
+          >
+            <X />
+          </button>
+        </div>
+        <div class="px-5 pb-5">{children}</div>
+      </div>
+    </div>
+  );
+};
